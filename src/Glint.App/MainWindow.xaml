<Window x:Class="Glint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Glint"
        Width="600"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Sleek ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border CornerRadius="3" Background="#3F3F46"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer drop shadow / glow container -->
    <Border Margin="16"
            CornerRadius="14"
            Background="#121316"
            BorderBrush="#2D3139"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="8"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.65" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- API Key Config Banner -->
                <RowDefinition Height="Auto" /> <!-- Prompt input area -->
                <RowDefinition Height="Auto" /> <!-- Status / progress -->
                <RowDefinition Height="Auto" /> <!-- Answer display area -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Border Grid.Row="0"
                    Background="#181A1F"
                    CornerRadius="13,13,0,0"
                    Padding="14,10,12,10"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Title & Icon -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="#3B82F6" Margin="0,0,8,0">
                            <TextBlock Text="✦" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="Glint" Foreground="#F4F4F5" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#23272F" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                            <TextBlock x:Name="HotkeyBadge" Text="Alt+Space" Foreground="#A1A1AA" FontSize="11" FontFamily="Consolas, Segoe UI"/>
                        </Border>
                    </StackPanel>

                    <!-- Header Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnToggleKey"
                                Content="🔑 API Key"
                                Background="#23272F"
                                Foreground="#D4D4D8"
                                BorderThickness="0"
                                Padding="8,4"
                                Margin="0,0,8,0"
                                Cursor="Hand"
                                Click="BtnToggleKey_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnClose"
                                Content="✕"
                                Background="Transparent"
                                Foreground="#71717A"
                                BorderThickness="0"
                                Width="26"
                                Height="26"
                                Cursor="Hand"
                                Click="BtnClose_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. API Key Configuration Drawer -->
            <Border x:Name="ApiKeyPanel"
                    Grid.Row="1"
                    Background="#1E2026"
                    BorderBrush="#2D3139"
                    BorderThickness="0,1,0,1"
                    Padding="14,12"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Gemini API Key (stored in Windows Credential Manager)"
                               Foreground="#E4E4E7"
                               FontSize="12"
                               FontWeight="Medium"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox"
                                     Background="#121316"
                                     Foreground="#FAFAFA"
                                     BorderBrush="#3F3F46"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     FontSize="13"/>
                        <Button x:Name="BtnSaveKey"
                                Grid.Column="1"
                                Content="Save Key"
                                Background="#2563EB"
                                Foreground="White"
                                FontWeight="Medium"
                                Margin="8,0,0,0"
                                Padding="12,6"
                                Cursor="Hand"
                                Click="BtnSaveKey_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ApiKeyStatusText"
                               Text="Key will be saved securely and never written to disk or repo."
                               Foreground="#71717A"
                               FontSize="11"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 3. Prompt Input Area -->
            <Border Grid.Row="2" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="PromptTextBox"
                             Background="#1A1C22"
                             Foreground="#FAFAFA"
                             BorderBrush="#2D3139"
                             BorderThickness="1"
                             Padding="10,8"
                             FontSize="14"
                             AcceptsReturn="False"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="100"
                             PreviewKeyDown="PromptTextBox_PreviewKeyDown"
                             CaretBrush="#60A5FA"/>

                    <Button x:Name="BtnSend"
                            Grid.Column="1"
                            Content="Send"
                            Background="#3B82F6"
                            Foreground="White"
                            FontWeight="SemiBold"
                            FontSize="13"
                            Margin="8,0,0,0"
                            Padding="14,0"
                            Cursor="Hand"
                            Click="BtnSend_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 4. Progress / Status indicator -->
            <Border x:Name="StatusPanel"
                    Grid.Row="3"
                    Padding="14,0,14,8"
                    Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar IsIndeterminate="True" Width="80" Height="3" Background="#27272A" Foreground="#3B82F6" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Analyzing screen with Gemini..." Foreground="#93C5FD" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- 5. Answer Display Area -->
            <Border x:Name="AnswerPanel"
                    Grid.Row="4"
                    Background="#16181D"
                    BorderBrush="#2D3139"
                    BorderThickness="0,1,0,0"
                    Padding="14,12"
                    MaxHeight="360"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Answer" Foreground="#9CA3AF" FontSize="11" FontWeight="SemiBold"/>
                        <Button x:Name="BtnCopy"
                                Content="Copy"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                Foreground="#93C5FD"
                                FontSize="11"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnCopy_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="AnswerTextBox"
                                 Background="Transparent"
                                 Foreground="#F4F4F5"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontSize="13.5"
                                 FontFamily="Segoe UI, Inter, sans-serif"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
